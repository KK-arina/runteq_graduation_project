# ==============================================================================
# .env.example - 環境変数のテンプレート（完成版 / #I-3）
# ==============================================================================
#
# 【このファイルの役割】
#   HabitFlow を動かすために必要な「環境変数（ENV）」の一覧と説明。
#   実際の秘密の値は書かず、キー名と説明だけを Git にコミットする。
#   新しく開発に参加する人・本番を設定する人が「何を設定すればいいか」を
#   一目で分かるようにするための設計図。
#
# 【使い方（ローカル開発）】
#   1. このファイルをコピーして .env を作る:
#        cp .env.example .env
#   2. .env の各値を自分のキーに書き換える（.env は .gitignore 済みでコミットされない）
#   3. docker compose up で起動する
#
# 【使い方（本番 = Render）】
#   .env ファイルは本番では使わない。
#   Render ダッシュボード → habitflow-web → Environment に、
#   下記のうち「本番で必要」と書かれたキーを1つずつ登録する。
#   （render.yaml に sync: false で宣言済みのキーは、Render の画面で値だけ入れる）
#
# 【凡例】
#   [開発・本番の両方]  ローカルでも本番でも設定が必要
#   [本番のみ]          Render にだけ設定（ローカルでは不要 or 別の仕組みを使う）
#   [Render 自動]       Render が自動で入れてくれる（自分で設定しなくてよい）
# ==============================================================================


# ==============================================================================
# 1. Rails のコア設定
# ==============================================================================

# RAILS_MASTER_KEY  [本番のみ]
#   config/credentials.yml.enc（暗号化された認証情報）を復号するための鍵。
#   ローカルでは config/master.key ファイルが自動で使われるため設定不要。
#   本番（Render）ではファイルを置かないので、この環境変数として渡す。
#   値は config/master.key の中身をそのままコピーする。
#   ⚠️ 絶対に Git にコミットしない・SNS 等に貼らない（漏れると全暗号情報が解ける）。
RAILS_MASTER_KEY=your_rails_master_key_here

# DATABASE_URL  [本番のみ / ローカルは任意]
#   PostgreSQL への接続文字列。
#   本番では Neon（AWS US West 2 (Oregon) リージョン。Render と同じ地域）の接続 URL を設定する。
#   形式: postgresql://ユーザー名:パスワード@ホスト/DB名?sslmode=require
#   ローカルの docker compose 環境では database.yml の database: 指定
#   （habitflow_development）が使われるため、通常は設定しなくてよい。
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# APP_HOST  [任意 / 独自ドメイン移行時に設定]
#   メール本文内のリンク・画像URLを組み立てるときのホスト名。
#   production.rb がこの値を使う（#I-3 でハードコードから環境変数化）。
#   【なぜ環境変数にするのか】
#     独自ドメイン（例: habitflow.jp）を取得した瞬間に、コードを一切触らず
#     この値を書き換えるだけでメールのリンク先を切り替えられるようにするため。
#   【未設定でも動く理由】
#     production.rb 側で ENV.fetch("APP_HOST", "habitflow-web.onrender.com") と
#     既定値を持たせているため、未設定なら現在の Render URL が使われる。
#     Render に設定するのは独自ドメインへ移行するときだけでよい。
# APP_HOST=habitflow-web.onrender.com


# ==============================================================================
# 2. Google ログイン（OmniAuth / F-1）
# ==============================================================================
#
# 【取得場所】
#   Google Cloud Console → 「APIとサービス」→「認証情報」→
#   「OAuth 2.0 クライアント ID」を作成すると発行される。
#
# 【承認済みリダイレクト URI の登録（超重要）】
#   Google Cloud Console 側に、以下のコールバック URL を登録しておくこと。
#   ここがズレていると本番でだけログインが「redirect_uri_mismatch」で失敗する。
#     本番:   https://habitflow-web.onrender.com/auth/google_oauth2/callback
#     ローカル: http://localhost:3000/auth/google_oauth2/callback

# GOOGLE_CLIENT_ID  [開発・本番の両方]
#   Google OAuth クライアント ID（末尾が .apps.googleusercontent.com）。
GOOGLE_CLIENT_ID=your_google_client_id_here

# GOOGLE_CLIENT_SECRET  [開発・本番の両方]
#   Google OAuth クライアントシークレット。
GOOGLE_CLIENT_SECRET=your_google_client_secret_here


# ==============================================================================
# 3. LINE ログイン（OmniAuth / F-2）
# ==============================================================================
#
# 【取得場所】
#   LINE Developers Console → 「LINE Login」チャネル →
#   「チャネル基本設定」タブでチャネル ID / チャネルシークレットを確認できる。
#
# 【コールバック URL の登録（超重要）】
#   LINE Developers Console の「LINE Login設定」→「コールバックURL」に登録する。
#   プロバイダ名が :line_v2_1 のため、パスは /auth/line_v2_1/callback になる。
#     本番:   https://habitflow-web.onrender.com/auth/line_v2_1/callback
#     ローカル: http://localhost:3000/auth/line_v2_1/callback

# LINE_CHANNEL_ID  [開発・本番の両方]
#   LINE Login チャネルのチャネル ID（数字）。
LINE_CHANNEL_ID=your_line_login_channel_id_here

# LINE_CHANNEL_SECRET  [開発・本番の両方]
#   LINE Login チャネルのチャネルシークレット。
LINE_CHANNEL_SECRET=your_line_login_channel_secret_here


# ==============================================================================
# 4. LINE 通知（Messaging API / G-1）
# ==============================================================================
#
# 【LINE Login チャネルとは別物】
#   「ログイン」は上の LINE Login チャネル、「通知（プッシュ送信）」は
#   Messaging API チャネルを使う。2 つは別チャネルなので混同しないこと。
#
# 【取得場所】
#   LINE Developers Console → Messaging API チャネル →
#   「Messaging API設定」タブ →「チャネルアクセストークン（長期）」で発行する。
#
# 【重要・友だち追加が前提】
#   プッシュ通知は「ユーザーが Messaging API チャネル（Bot）を友だち追加済み」の
#   場合のみ届く。未追加ユーザーには HTTP 400 になり、メール通知へ自動で切り替わる。
#   友だち追加 URL 形式: https://line.me/R/ti/p/@{チャネルID}

# LINE_CHANNEL_ACCESS_TOKEN  [本番のみ / 通知を試すなら開発でも]
#   Messaging API のチャネルアクセストークン（長期）。
#   未設定だと通知はスキップされメールにフォールバックする。
LINE_CHANNEL_ACCESS_TOKEN=your_line_messaging_api_access_token_here


# ==============================================================================
# 5. AI 分析（Gemini / Groq / D-2）
# ==============================================================================
#
# 【動作】
#   まず Gemini を呼び、失敗（レート制限・タイムアウト等）したら Groq に
#   自動フォールバックする（AiClient が制御）。両方無いと AI 分析は失敗扱いになる。

# GEMINI_API_KEY  [開発・本番の両方]
#   Google AI Studio（aistudio.google.com）で発行する Gemini API キー。
#   モデルは gemini-2.5-flash を使用。
GEMINI_API_KEY=your_gemini_api_key_here

# GROQ_API_KEY  [開発・本番の両方 / 任意だが推奨]
#   Groq（console.groq.com）で発行するフォールバック用 API キー。
#   モデルは openai/gpt-oss-120b を使用（下の GROQ_MODEL 参照）。
#   未設定でも動くが、Gemini 障害時のフォールバックが効かなくなるため設定を推奨。
GROQ_API_KEY=your_groq_api_key_here

# GROQ_MODEL  [任意]
#   フォールバック時に使う Groq のモデル名。
#   未設定なら app/services/ai_client.rb の既定値（openai/gpt-oss-120b）が使われる。
#   【なぜ環境変数にするのか】
#     Groq はモデルを定期的に入れ替える（旧 llama-3.3-70b-versatile は
#     2026-08-16 に廃止され、呼ぶと HTTP 404 になった）。
#     モデル名を環境変数にしておけば、次に廃止されてもここを変えるだけで
#     コード修正・再デプロイなしに切り替えられる。
#   有効なモデル一覧: https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-120b

# AI_PROVIDER  [任意]
#   使用する AI プロバイダを固定したいときに指定する（"gemini" or "groq"）。
#   未設定なら "gemini" が既定。通常は設定しなくてよい。
# AI_PROVIDER=gemini


# ==============================================================================
# 6. メール送信（Resend / A-4）
# ==============================================================================
#
# 【取得場所】
#   Resend（resend.com）→ API Keys で発行する。
#   本番では「Sending access」権限のキーを推奨（最小権限の原則）。
#
# 【送信元（独自ドメイン）】
#   Resend で独自ドメイン mail.habitflow-arina.com を検証済みで、
#   送信元は ApplicationMailer の no-reply@mail.habitflow-arina.com。
#   （Resend の既定のテスト送信元 onboarding@resend.dev のままだと、
#     Resend に登録した自分のアドレスにしか送れない）
#
# 【ローカル開発では不要】
#   開発環境は letter_opener でブラウザにメールを表示するため、
#   ローカルでは RESEND_API_KEY を設定しなくてよい。

# RESEND_API_KEY  [本番のみ]
RESEND_API_KEY=your_resend_api_key_here


# ==============================================================================
# 7. エラー監視（Sentry / I-5）
# ==============================================================================

# SENTRY_DSN  [本番のみ]
#   Sentry プロジェクトの送信先 URL。
#   このキーが設定されているときだけ Sentry が有効になる
#   （sentry.rb と layout の両方が ENV["SENTRY_DSN"].present? で判定）。
#   開発では空のままにして送信を止め、無料枠を本番のために温存する。
SENTRY_DSN=


# ==============================================================================
# 8. GoodJob 管理ダッシュボードの Basic 認証（本番保護）
# ==============================================================================
#
# 【役割】
#   本番の /good_job 管理画面（ジョブの実行状況を見る画面）を
#   Rack::Auth::Basic で保護するためのユーザー名とパスワード。
#   未設定だと管理画面が誰でも見られてしまうため、本番では必ず設定する。

# GOOD_JOB_LOGIN  [本番のみ]
GOOD_JOB_LOGIN=your_goodjob_admin_user_here

# GOOD_JOB_PASSWORD  [本番のみ]
GOOD_JOB_PASSWORD=your_goodjob_admin_password_here


# ==============================================================================
# 9. 管理画面（/admin）を開ける人
# ==============================================================================

# ADMIN_EMAILS  [開発・本番の両方 / 任意]
#   管理画面（ユーザー・利用状況の集計）を開けるユーザーのメールアドレス。
#   複数ならカンマ区切り。大文字・小文字と前後の空白は区別しない。
#   メールアドレスか Google でログインしたユーザーだけが対象（LINE ログイン・退会済みは対象外）。
#   開くには、12時間以内にログインし直している必要がある
#   （「ログインしたままにする」の自動ログインだけでは開けない）。
#   未設定なら、だれも管理画面を開けない（/admin は 404 になる）。
#   本番は Render の Environment に登録する。値はチャットや Issue などに貼らない。
#   ローカルでは .env に書くと、docker-compose.yml 経由で web コンテナに渡る。
# ADMIN_EMAILS=you@example.com


# ==============================================================================
# 10. Render が自動で設定する変数（自分で設定しなくてよい・参考）
# ==============================================================================
#
# 以下は render.yaml で宣言済み、または Render が自動注入するため、
# 通常は手動設定不要。理解のために記載しておく。
#
#   PORT                     [Render 自動]  Puma が待ち受けるポート。
#   RENDER_GIT_COMMIT        [Render 自動]  デプロイのコミット SHA。Sentry の release に使用。
#   RAILS_ENV=production     [render.yaml]  本番環境として起動。
#   RAILS_LOG_TO_STDOUT=true [render.yaml]  ログを標準出力へ（Render が収集）。
#   RAILS_SERVE_STATIC_FILES=true [render.yaml]  Rails が静的ファイルを配信。
#   WEB_CONCURRENCY=2        [render.yaml]  Puma の Worker 数。
#   RAILS_MAX_THREADS        [任意]         Puma / DB プールのスレッド数（既定 3）。
#
# SEED_IN_PRODUCTION  [本番のみ・ふだんは false]
#   true にすると、docker-entrypoint が「起動するたびに」db:seed を実行する。
#   本番の db:seed は習慣テンプレート（db/seeds/habit_templates.rb）だけを読み込み、
#   「あれば更新・なければ作成」するため、何度実行しても利用者のデータは消えない。
#   ただし起動のたびに DB への問い合わせが増えるので、ふだんは false にしておく。
#   テンプレートを変えたときだけ: true → デプロイ → 反映を確認 → false に戻す。
# SEED_IN_PRODUCTION=false

# ------------------------------------------------------------------
# 開発・テスト用 DB 接続（任意・#I-3 で config/database.yml が参照）
# ------------------------------------------------------------------
# これらは未設定でも動く（config/database.yml 側に既定値あり）。
#   DB_HOST     … 既定値 "db"（docker-compose の db サービス名）
#   DB_USERNAME … 既定値 "postgres"
#   DB_PASSWORD … 既定値 "postgres"
# ローカルの PostgreSQL 設定を変えたい人だけ上書きする。
# 本番（Render）は DATABASE_URL 一本で Neon に接続するため、これらは使わない。
# ------------------------------------------------------------------
# DB_HOST=db
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
