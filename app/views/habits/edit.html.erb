<%# app/views/habits/edit.html.erb %>
<%# ==============================================================================
    習慣編集ページ（B-6: カラー・アイコン選択追加）
    ==============================================================================
    【new.html.erb との違い】
      ① カラーの初期値は @habit.color.presence || "#3b82f6"（DB の値）
      ② アイコンの初期値は @habit.icon.presence || "📋"（DB の値）
      ③ measurement_type は変更不可のため radio ではなく hidden + 表示のみ

    【C-6 追加修正】
      ④ チェック型習慣の weekly_target フィールドを非表示にする。

    ============================================================
    【H-6 レスポンシブ調整での変更点】
    ============================================================

    ① 習慣名 inputのフォントサイズを text-sm → text-base（16px）に変更
       【理由】iOS Safari は 16px 未満の input をタップするとページがズームされる。
               text-base（16px）にすることでズームを防止できる。

    ② 単位 inputのフォントサイズを text-sm → text-base（16px）に変更（理由は①と同様）

    ③ 週次目標値 number inputのフォントサイズを text-sm → text-base（16px）に変更（理由は①と同様）

    縦余白（py-3）は既に適切なサイズが設定されているため変更なし。

    ============================================================
    【アクセシビリティ修正での変更点】
    ============================================================

    ① 「カラー」「アイコン」「除外する曜日」の見出しを label から fieldset + legend に変更
       （理由は new.html.erb と同じ。選択肢のグループの見出しには legend を使う）

    ② 「記録タイプ」の見出しを label から p に変更
       【理由】編集画面の記録タイプは変更できない「表示だけ」の項目で、
         選択する入力欄がない。結び付ける相手のいない label は警告の対象になるため、
         ふつうの見出し（p）にする。見た目のクラスは同じ。

    ③ カラー・アイコンのボタンに aria-pressed を追加（理由は new.html.erb と同じ）
    ==============================================================================
%>
<% content_for :title, "習慣を編集 | HabitFlow" %>

<div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  <div class="mb-6">
    <%= link_to "← 習慣管理に戻る", habits_path,
          class: "text-sm text-blue-600 hover:text-blue-800 hover:underline transition-colors" %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-6">習慣を編集</h1>

  <%= render "shared/form_errors", model: @habit %>

  <%= form_with model: @habit,
                local: true,
                class: "space-y-6",
                data: { controller: "habit-form" } do |f| %>

    <%# 習慣名（H-6: text-base に変更） %>
    <%# 入力欄1つの見出しなので label のままでよい（for="habit_name" と id="habit_name" が一致） %>
    <div>
      <%= f.label :name, "習慣名",
            class: "block text-sm font-semibold text-gray-700 mb-1" %>
      <%#
        text-base（16px）に変更する理由（H-6）:
          iOS Safari は 16px 未満の input をタップするとページがズームされる。
          text-sm（14px）から text-base（16px）に変更してズームを防止する。
      %>
      <%= f.text_field :name,
            placeholder: "例: 読書、筋トレ、英語学習",
            maxlength: 50,
            class: "w-full px-4 py-3 border border-gray-300 rounded-xl text-base
                    focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
                    transition-colors" %>
    </div>

    <%# カラー選択（B-6 追加・アクセシビリティ修正で fieldset 化） %>
    <%#
      fieldset: 色ボタン8個と hidden の color を1つのグループにまとめる。
      legend: グループの見出し。以前の label と同じ見た目のクラスを付けている。
      aria-describedby: 説明文（id="habit_color_hint"）をグループの説明として読み上げさせる。
      min-w-0: fieldset が中身より狭くならない初期設定を解除し、スマホではみ出さないようにする。
    %>
    <fieldset class="min-w-0" aria-describedby="habit_color_hint">
      <legend class="block text-sm font-semibold text-gray-700 mb-1">カラー</legend>
      <p id="habit_color_hint" class="text-xs text-gray-500 mb-3">習慣カードの左ボーダーの色を選択してください</p>

      <%= f.hidden_field :color,
            value: @habit.color.presence || "#3b82f6",
            data: { habit_form_target: "colorInput" } %>

      <% habit_colors = [
           { value: "#3b82f6", label: "ブルー",  bg: "bg-blue-500"   },
           { value: "#10b981", label: "グリーン", bg: "bg-emerald-500" },
           { value: "#f59e0b", label: "アンバー", bg: "bg-amber-500"   },
           { value: "#ef4444", label: "レッド",  bg: "bg-red-500"    },
           { value: "#8b5cf6", label: "パープル", bg: "bg-violet-500"  },
           { value: "#ec4899", label: "ピンク",  bg: "bg-pink-500"   },
           { value: "#06b6d4", label: "シアン",  bg: "bg-cyan-500"   },
           { value: "#64748b", label: "スレート", bg: "bg-slate-500"  }
         ] %>

      <% selected_color = @habit.color.presence || "#3b82f6" %>
      <div class="flex gap-3 flex-wrap">
        <% habit_colors.each do |color_item| %>
          <%#
            aria-pressed（アクセシビリティ修正で追加）:
              DB に保存されている色のボタンだけ "true" にする。
          %>
          <button type="button"
                  class="w-9 h-9 rounded-full transition-all
                        focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400
                        <%= color_item[:bg] %>
                        <%= selected_color == color_item[:value] ? 'ring-2 ring-offset-2 ring-gray-800 scale-110' : 'hover:scale-110' %>"
                  data-action="click->habit-form#selectColor"
                  data-color-value="<%= color_item[:value] %>"
                  data-habit-form-target="colorSwatch"
                  aria-pressed="<%= selected_color == color_item[:value] %>"
                  aria-label="<%= color_item[:label] %>を選択">
          </button>
        <% end %>
      </div>
    </fieldset>

    <%# アイコン選択（B-6 追加・アクセシビリティ修正で fieldset 化） %>
    <fieldset class="min-w-0" aria-describedby="habit_icon_hint">
      <legend class="block text-sm font-semibold text-gray-700 mb-1">アイコン</legend>
      <p id="habit_icon_hint" class="text-xs text-gray-500 mb-3">習慣カードに表示する絵文字を選択してください</p>

      <%= f.hidden_field :icon,
            value: @habit.icon.presence || "📋",
            data: { habit_form_target: "iconInput" } %>

      <% habit_icons = ["📚", "💪", "🏃", "🧘", "✍️", "🎵",
                        "💻", "🌱", "🍎", "😴", "🎯", "⭐",
                        "📋", "🔥", "💡", "🎨"] %>

      <%# selected_icon: class と aria-pressed で同じ判定を使い、食い違いを防ぐための変数 %>
      <% selected_icon = @habit.icon.presence || "📋" %>

      <div class="grid grid-cols-8 sm:grid-cols-8 gap-2">
        <% habit_icons.each do |icon| %>
          <button type="button"
                  class="aspect-square flex items-center justify-center text-xl
                         border-2 rounded-lg transition-all
                         focus:outline-none focus:ring-2 focus:ring-blue-500
                         <%= selected_icon == icon ? 'border-blue-500 bg-blue-50 scale-110' : 'border-gray-200 hover:border-blue-300 hover:bg-blue-50' %>"
                  data-action="click->habit-form#selectIcon"
                  data-icon-value="<%= icon %>"
                  data-habit-form-target="iconButton"
                  aria-pressed="<%= selected_icon == icon %>"
                  aria-label="<%= icon %>を選択">
            <%= icon %>
          </button>
        <% end %>
      </div>
    </fieldset>

    <%# measurement_type（変更不可・アクセシビリティ修正で見出しを p に変更） %>
    <%#
      編集画面では記録タイプを変更できないため、選べる入力欄がない。
      結び付く相手のいない label は警告の対象になるので、ふつうの見出し（p）にする。
      送信用の値は下の hidden_field で送る（これまでと同じ）。
    %>
    <div>
      <p class="block text-sm font-semibold text-gray-700 mb-1">記録タイプ</p>
      <div class="px-4 py-3 border border-gray-200 rounded-xl bg-gray-50 text-sm text-gray-500">
        <%= @habit.check_type? ? "☑️ チェック型（やった/やらない）" : "🔢 数値型（#{@habit.unit}で記録）" %>
        <span class="ml-2 text-xs text-gray-500">※ 過去データの整合性のため変更できません</span>
      </div>
      <%= f.hidden_field :measurement_type %>
    </div>

    <%# unit（数値型のみ表示） %>
    <% if @habit.numeric_type? %>
      <div>
        <%= f.label :unit, "単位",
              class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%#
          text-base（16px）に変更する理由（H-6）:
            iOS Safari は 16px 未満の input をタップするとページがズームされる。
            text-sm から text-base に変更してズームを防止する。
        %>
        <%= f.text_field :unit,
              placeholder: "例: 分、冊、km",
              maxlength: 10,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl text-base
                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
                      transition-colors" %>
      </div>
    <% end %>

    <%#
      週次目標値（C-6 変更: チェック型は非表示）
      H-6 変更: text-sm → text-base（iOS自動ズーム防止）
    %>
    <% if @habit.check_type? %>
      <%# チェック型: weekly_target を hidden で送信する（7固定）%>
      <%= f.hidden_field :weekly_target, value: 7 %>
    <% else %>
      <%# 数値型: weekly_target の入力フィールドを表示する %>
      <div>
        <%= f.label :weekly_target, "週次目標値",
              class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <p class="text-xs text-gray-500 mb-2">
          1週間の目標を設定してください（単位: 1以上の数値）
        </p>
        <%#
          text-base（16px）に変更する理由（H-6）:
            iOS Safari は 16px 未満の input をタップするとページがズームされる。
            number_field にも text-base を適用してズームを防止する。
        %>
        <%= f.number_field :weekly_target,
              min: 1,
              class: "w-full px-4 py-3 border border-gray-300 rounded-xl text-base
                      focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500
                      transition-colors" %>
      </div>
    <% end %>

    <%# 除外する曜日（アクセシビリティ修正で fieldset 化） %>
    <%#
      チェックボックス7個のグループなので fieldset + legend にする。
      説明文と注意書きの2つを aria-describedby で結び付ける（空白区切りで複数指定できる）。
    %>
    <fieldset class="min-w-0" aria-describedby="habit_excluded_days_hint habit_excluded_days_note">
      <legend class="block text-sm font-semibold text-gray-700 mb-1">除外する曜日</legend>
      <p id="habit_excluded_days_hint" class="text-xs text-gray-500 mb-3">実施しない曜日を選択してください（達成率の計算から除外されます）</p>
      <% selected_days = if params.key?(:excluded_day_numbers)
                           Array(params[:excluded_day_numbers]).map(&:to_i)
                         else
                           @habit.excluded_day_numbers
                         end %>
      <%#
        grid-cols-4: スマホ（375px）では4列。各セル幅 ≈ 84px で十分なタップ領域がある。
        sm:grid-cols-7: 640px以上では7列（曜日をすべて1行に並べる）。
      %>
      <div class="grid grid-cols-4 sm:grid-cols-7 gap-2">
        <% HabitExcludedDay::DAY_NAMES_FULL.each do |day_number, day_name| %>
          <label class="flex flex-col items-center gap-1.5 p-2 border-2 rounded-lg cursor-pointer
                        transition-colors hover:border-blue-300 hover:bg-blue-50
                        has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50
                        focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-1">
            <%= check_box_tag "excluded_day_numbers[]", day_number,
                  selected_days.include?(day_number),
                  id: "excluded_day_#{day_number}",
                  class: "sr-only" %>
            <span class="text-xs font-bold text-gray-600"><%= day_name %></span>
          </label>
        <% end %>
      </div>
      <p id="habit_excluded_days_note" class="text-xs text-gray-500 mt-2">※ 例: 土日を除外すると週5日が最大達成日数になります</p>
    </fieldset>

    <%# ボタンエリア %>
    <div class="flex justify-end items-center gap-4 pt-2">
      <%= link_to "キャンセル", habits_path,
            class: "px-5 py-3 bg-white border border-gray-300 text-gray-700 text-sm font-semibold
                    rounded-xl hover:bg-gray-50 transition-colors
                    focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-400" %>
      <%= f.submit "更新する",
            class: "flex-1 py-3 px-4 bg-blue-600 text-white text-sm font-semibold
                    rounded-xl hover:bg-blue-700 transition-colors cursor-pointer
                    focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>

  <% end %>
</div>